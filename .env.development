VEB_DB_NAME="veb"
VEB_DB_USER="veb"
VEB_DB_PASSWORD="veb-development"
VEB_DB_PORT="5432"
VEB_DATABASE_URL="postgresql://veb:veb-development@veb-postgres:5432/veb?schema=public"

BLOG_DB_NAME="veb_blog"
BLOG_DB_USER="veb_blog"
BLOG_DB_PASSWORD="veb-blog-development"
BLOG_DB_PORT="5433"
BLOG_DATABASE_URL="postgresql://veb_blog:veb-blog-development@blog-postgres:5432/veb_blog?schema=public"

AUTH_SECRET="development-only-auth-secret-change-before-sharing"
AUTH_URL="http://localhost:1066"
BLOG_VISITOR_HASH_SECRET="development-only-visitor-secret"

# Replace these placeholders with a development RSA key pair before starting all Compose services.
SERVICE_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SERVICE_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SERVICE_AUTH_KEY_ID="veb-development-1"

WEB_PORT="1066"
BLOG_API_PORT="1068"
VEB_API_INTERNAL_URL="http://veb-api:1067"
BLOG_API_INTERNAL_URL="http://blog-api:1068"
