{
  "name": "@veb/blog-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 1068",
    "build": "next build",
    "start": "next start -p 1068",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "node --env-file=.env.development ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file=.env.development ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:dev": "node --env-file=.env.development ./node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file=.env.development ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:deploy:production": "node --env-file=.env.production ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file=.env.development ./node_modules/tsx/dist/cli.mjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@veb/api-contracts": "workspace:*",
    "@veb/service-auth": "workspace:*",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
