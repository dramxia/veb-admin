{
  "name": "veb-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:infra": "docker compose --env-file .env.development up -d postgres",
    "dev:all": "pnpm dev:infra && pnpm db:migrate:deploy && pnpm dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm test:dev-ports && pnpm -r --if-present test",
    "test:dev-ports": "node --test scripts/dev.test.mjs",
    "test:e2e": "pnpm --filter @veb/web test:e2e",
    "db:generate": "pnpm --filter @veb/core-api prisma:generate",
    "db:migrate:dev": "pnpm --filter @veb/core-api prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @veb/core-api prisma:migrate:deploy",
    "db:migrate:deploy:production": "pnpm --filter @veb/core-api prisma:migrate:deploy:production",
    "db:seed": "pnpm --filter @veb/core-api db:seed",
    "db:verify:init": "./deploy/verify-init.sh",
    "compose:up": "docker compose --env-file .env.development up --build",
    "compose:deploy": "./deploy/compose-deploy.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
