VEB_DB_NAME="veb"
VEB_DB_USER="veb"
VEB_DB_PASSWORD="replace-with-a-random-password"
VEB_DB_PORT="5432"
# Prisma URL used inside Compose. Percent-encode reserved characters in the password.
VEB_DATABASE_URL="postgresql://veb:replace-with-a-random-password@veb-postgres:5432/veb?schema=public"

BLOG_DB_NAME="veb_blog"
BLOG_DB_USER="veb_blog"
BLOG_DB_PASSWORD="replace-with-a-different-random-password"
BLOG_DB_PORT="5433"
BLOG_DATABASE_URL="postgresql://veb_blog:replace-with-a-different-random-password@blog-postgres:5432/veb_blog?schema=public"

AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:1066"
BLOG_VISITOR_HASH_SECRET="use-the-legacy-nextauth-secret-for-the-first-cutover"

# Generate an RSA key pair and store each PEM on one line with literal \n escapes.
SERVICE_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SERVICE_AUTH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
SERVICE_AUTH_KEY_ID="veb-local-1"

WEB_PORT="1066"
BLOG_API_PORT="1068"

# Runtime targets for the Web same-origin API proxy. They must be reachable
# from the running Web container and can be changed without rebuilding it.
VEB_API_INTERNAL_URL="http://veb-api:1067"
BLOG_API_INTERNAL_URL="http://blog-api:1068"
